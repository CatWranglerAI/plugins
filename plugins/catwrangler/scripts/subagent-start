#!/bin/sh
# POSIX half of Claude's dot-sourced SubagentStart dispatch basename.
# PowerShell resolves the same relative name to subagent-start.ps1.

set -u

if [ -n "${CATWRANGLER_PLUGIN_ROOT:-}" ]; then
  SCRIPT_DIR="$CATWRANGLER_PLUGIN_ROOT/scripts"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  SCRIPT_DIR="$CLAUDE_PLUGIN_ROOT/scripts"
else
  SCRIPT_DIR=$PWD
fi
SESSION_DIR=${CLAUDE_PROJECT_DIR:-${OLDPWD:-}}

if [ -n "$SESSION_DIR" ] && [ -d "$SESSION_DIR" ]; then
  cd "$SESSION_DIR" 2>/dev/null || :
fi

exec sh "$SCRIPT_DIR/session-start.sh" claude subagent-start.mjs SubagentStart
