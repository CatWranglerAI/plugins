{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CODEX_PLUGIN_ROOT}/scripts/session-start.sh\" session-start-codex.mjs",
            "statusMessage": "Connecting to CatWrangler",
            "additionalContextLimit": 8000
          }
        ]
      }
    ]
  }
}
